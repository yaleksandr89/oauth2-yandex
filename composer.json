{
    "name": "yaleksandr89/oauth2-yandex",
    "description": "Modern Yandex ID OAuth 2.0 provider client for league/oauth2-client.",
    "homepage": "https://github.com/yaleksandr89/oauth2-yandex",
    "keywords": [
        "oauth",
        "oauth2",
        "oauth2-client",
        "yandex",
        "yandex-id",
        "authentication",
        "authorization"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/oauth2-yandex/issues",
        "source": "https://github.com/yaleksandr89/oauth2-yandex",
        "forum": "https://github.com/yaleksandr89/oauth2-yandex/discussions",
        "security": "https://github.com/yaleksandr89/oauth2-yandex/security/policy"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "league/oauth2-client": "^2.9",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\OAuth2\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\OAuth2\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --configuration phpunit.xml.dist --coverage-text"
        ],
        "analyse": "phpstan analyse --configuration phpstan.neon.dist --no-progress",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
